# Copy to .env for local development. Production values come from the ECS
# task definition (Secrets Manager); nothing here is a secret default.
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
# Per-role database URLs (Data Model section 2); local compose values
DATABASE_URL_APP=postgres://xms_app:xms@localhost:5432/xms
DATABASE_URL_WORKER=postgres://xms_worker:xms@localhost:5432/xms
DATABASE_URL_PORTAL=postgres://xms_portal:xms@localhost:5432/xms
