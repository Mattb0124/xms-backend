# Copy to .env for local development. Production values come from the ECS
# task definition (Secrets Manager); nothing here is a secret default.
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
# Per-role database URLs (Data Model section 2); local compose values
DATABASE_URL_APP=postgres://xms_app:xms@localhost:5433/xms
DATABASE_URL_WORKER=postgres://xms_worker:xms@localhost:5433/xms
DATABASE_URL_PORTAL=postgres://xms_portal:xms@localhost:5433/xms

DATABASE_URL_MIGRATOR=postgres://xms_migrator:xms@localhost:5433/xms

# Identity. Leave CLERK_* empty until the XMS Clerk application exists; local
# development signs in with tokens from `pnpm dev:token` (never in production).
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_AGENTS_AUDIENCE=xms-axel
CLERK_INTERNAL_ORG_SLUG=hackett
HARNESS_SESSION_SECRET=
AUTH_DEV_SECRET=local-development-secret-change-me
BOOTSTRAP_ADMIN_EMAILS=admin@example.test
IP_HASH_SALT=local

# Storage and mail. Local store and file transport for development; S3 and SES in AWS.
STORAGE_KIND=local
STORAGE_LOCAL_ROOT=.xms-storage
STORAGE_SIGNING_SECRET=local-storage-signing-secret-change-me
API_BASE_URL=http://localhost:3001
MAIL_TRANSPORT=file
MAIL_DOMAIN=mail.xms.local
# The SNS topics the SES receiver accepts. Unset means it refuses every
# notification, since AWS signs anyone's topic with its own key.
SES_SNS_TOPIC_ARNS=
SNS_WEBHOOK_SECRET=

# Seals webhook and finance signing secrets at rest. 32 raw bytes, or their
# 44-character base64; production refuses anything weaker. The webhook and
# finance destination screens need it.
WEBHOOK_SECRETS_KEY=local-webhook-sealing-key-32bytes
# Local stacks may deliver to private addresses; production never does.
WEBHOOK_ALLOW_PRIVATE=true

# What to believe about X-Forwarded-For. Unset locally (nothing in front);
# "1" behind one load balancer, or an address or subnet list.
TRUST_PROXY=

# Rate limits per caller per minute on the outward-facing routes; 0 disables a policy
RATE_LIMIT_PORTAL_PER_MINUTE=300
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=60

# Axel harness (leave HARNESS_BASE_URL empty to run without AI)
HARNESS_BASE_URL=
HARNESS_ORIGIN=http://localhost:3000
HARNESS_TENANT_SLUG=
AI_SERVICE_USER_EMAIL=axel-service@xms.local
